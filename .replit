run = "sh -lc '(cd backend && npx tsx src/api/server.ts) & (cd frontend && npm run dev) & wait -n'"

[nix]
channel = "stable-24_05"

[env]
BACKEND_PORT = "8000"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8000

[deployment]
build = ["sh", "-lc", "cd backend && npm ci && npx prisma generate && npx prisma migrate deploy && cd ../frontend && npm ci && npm run build"]
run = ["sh", "-lc", "(cd backend && npx tsx src/api/server.ts) & (cd frontend && npm run start -- --hostname 0.0.0.0 --port 3000) & wait -n"]
